{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  labels: [
    'dependencies',
  ],
  extends: [
    'config:best-practices',
    ':disableDependencyDashboard',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'repoURL:\\s*oci://(?<depName>[^\\s]+)[\\s\\S]*?\\btargetRevision:\\s*(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
      extractVersionTemplate: null,
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'ECR_CREDENTIAL_PROVIDER_VERSION="(?<currentValue>v\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'loafoe/cloud-provider-aws',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      matchDepNames: [
        'ghcr.io/argoproj/argo-helm/argo-cd',
      ],
      groupName: 'argo-cd chart (OCI)',
    },
  ],
}
